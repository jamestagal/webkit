{
  "id": null,
  "uid": "observability",
  "title": "Errors & Traces",
  "timezone": "browser",
  "version": 2,
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "errors",
    "observability"
  ],
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "query": "label_values(traces_span_metrics_calls_total, service_name)",
        "datasource": {
          "uid": "victoriametrics",
          "type": "victoriametrics-metrics-datasource"
        },
        "refresh": 2,
        "allValue": ".+",
        "includeAll": true,
        "multi": false,
        "current": {}
      },
      {
        "name": "trace_service",
        "label": "Trace Service",
        "type": "query",
        "query": "label_values(traces_span_metrics_calls_total, service_name)",
        "datasource": {
          "uid": "victoriametrics",
          "type": "victoriametrics-metrics-datasource"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Throughput (RPS)",
      "datasource": {
        "uid": "victoriametrics",
        "type": "victoriametrics-metrics-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Error Rate (%)",
      "datasource": {
        "uid": "victoriametrics",
        "type": "victoriametrics-metrics-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\"}[5m])) * 100",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "p99 Latency (ms)",
      "datasource": {
        "uid": "victoriametrics",
        "type": "victoriametrics-metrics-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      }
    },
    {
      "type": "nodeGraph",
      "title": "Service Graph",
      "datasource": {
        "uid": "victoriatraces",
        "type": "jaeger"
      },
      "targets": [
        {
          "datasource": {
            "type": "jaeger",
            "uid": "victoriatraces"
          },
          "refId": "A",
          "queryType": "dependencyGraph",
          "limit": 20,
          "tableType": "traces",
          "metricsQueryType": "range",
          "serviceMapUseNativeHistograms": false
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "options": {
        "zoomMode": "cooperative",
        "layoutAlgorithm": "layered",
        "nodes": {},
        "edges": {}
      }
    },
    {
      "type": "bargauge",
      "title": "Top Slowest Endpoints (p99)",
      "description": "Slowest gRPC methods by p99 latency across all services",
      "datasource": {
        "uid": "victoriametrics",
        "type": "victoriametrics-metrics-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.99, sum by (le, rpc_service, rpc_method, service_name) (increase(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\", rpc_method!=\"\"}[$__range]))))",
          "legendFormat": "{{service_name}}/{{rpc_service}}/{{rpc_method}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Auth Refresh Outcomes",
      "datasource": {
        "uid": "victoriametrics",
        "type": "victoriametrics-metrics-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result, reason) (rate(gofast_auth_refresh_total[$__rate_interval]))",
          "legendFormat": "{{result}} / {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 16,
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "type": "timeseries",
      "title": "Authorization Denials",
      "datasource": {
        "uid": "victoriametrics",
        "type": "victoriametrics-metrics-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason, access) (rate(gofast_authorize_denied_total[$__rate_interval]))",
          "legendFormat": "{{reason}} / {{access}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 16,
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "type": "timeseries",
      "title": "DB Query p95 (s)",
      "datasource": {
        "uid": "victoriametrics",
        "type": "victoriametrics-metrics-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, query) (rate(gofast_db_query_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{query}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 16,
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "timeseries",
      "title": "External Call p95 (s)",
      "datasource": {
        "uid": "victoriametrics",
        "type": "victoriametrics-metrics-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, provider, operation) (rate(gofast_external_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{provider}} / {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 16,
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "type": "table",
      "title": "Recent Traces",
      "description": "Latest traces from VictoriaTraces. Click a Trace ID to open the full trace view.",
      "datasource": {
        "uid": "victoriatraces",
        "type": "jaeger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "victoriatraces",
            "type": "jaeger"
          },
          "queryType": "search",
          "tableType": "table",
          "service": "$trace_service",
          "tags": "",
          "minDuration": "",
          "maxDuration": "",
          "limit": 50
        }
      ],
      "transformations": [
        {
          "id": "limit",
          "options": {
            "limitField": 50
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "durationMs": "Duration (ms)",
              "rootService": "Service",
              "rootSpanName": "Root Span",
              "traceID": "Trace ID"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 44
      }
    },
    {
      "type": "table",
      "title": "Recent Error Traces",
      "description": "Recent traces with error spans from VictoriaTraces.",
      "datasource": {
        "uid": "victoriatraces",
        "type": "jaeger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "victoriatraces",
            "type": "jaeger"
          },
          "queryType": "search",
          "tableType": "table",
          "service": "$trace_service",
          "tags": "error=true",
          "minDuration": "",
          "maxDuration": "",
          "limit": 50
        }
      ],
      "transformations": [
        {
          "id": "limit",
          "options": {
            "limitField": 50
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "durationMs": "Duration (ms)",
              "rootService": "Service",
              "rootSpanName": "Root Span",
              "traceID": "Trace ID"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 44
      }
    },
    {
      "type": "logs",
      "title": "All Logs",
      "description": "All application logs",
      "datasource": {
        "uid": "victorialogs",
        "type": "victoriametrics-logs-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service.name=~\"$service\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },
    {
      "type": "logs",
      "title": "Error Logs",
      "description": "Error logs",
      "datasource": {
        "uid": "victorialogs",
        "type": "victoriametrics-logs-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service.name=~\"$service\"} severity:ERROR",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 32
      }
    }
  ]
}
