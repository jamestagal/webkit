{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webkit-marketing",
  // Latest date the bundled Miniflare (4.20260424.0) recognises — using install
  // date (2026-04-27) tripped Miniflare's "date in the future" validator during
  // local build. Cloudflare runtime knows all dates; the lag is a local-tooling
  // artefact. Bump deliberately when adopting newer runtime features (and when
  // wrangler/Miniflare ships a newer baseline), not as a chore.
  "compatibility_date": "2026-04-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  // DNS cutover: claims webkit.au apex for the webkit-marketing Worker.
  // Pre-step (manual, completed by Benjamin): old webkit-landing Pages
  // project's apex binding removed; webkit.au added as a Custom Domain
  // on the webkit-marketing Worker in the Cloudflare dashboard.
  //
  // Apex + www both claimed as Custom Domains on this Worker. Both must
  // be pre-added in the Cloudflare dashboard (Custom Domains tab on the
  // webkit-marketing Worker) — Cloudflare validates the binding at
  // deploy time and rejects the wrangler push if either is missing.
  //
  // Rollback: revert this routes block + redeploy. Cloudflare Custom
  // Domain detach is non-destructive; underlying DNS zone untouched.
  "routes": [
    { "pattern": "webkit.au", "custom_domain": true },
    { "pattern": "www.webkit.au", "custom_domain": true }
  ]
}
