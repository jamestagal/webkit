---
import AISection from "@components/landing/AISection.astro";
import BrandingHighlight from "@components/landing/BrandingHighlight.astro";
import FeatureGrid from "@components/landing/FeatureGrid.astro";
import FinalCTA from "@components/landing/FinalCTA.astro";
import HeroWebkit from "@components/landing/HeroWebkit.astro";
import HowItWorks from "@components/landing/HowItWorks.astro";
import Pricing from "@components/landing/Pricing.astro";
import StatsRow from "@components/landing/StatsRow.astro";
import TrustSignals from "@components/landing/TrustSignals.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const title = "Webkit — Client Consultation & Proposal Platform for Web Agencies";
const description =
  "Create professional consultations, proposals, quotations, contracts and invoices for your web agency. Customizable forms, agency branding, AI-powered generation, and Content Intelligence with SEO audits. Free tier available.";
---

<BaseLayout title={title} description={description}>
  <HeroWebkit />
  <StatsRow />
  <FeatureGrid />
  <AISection />
  <BrandingHighlight />
  <HowItWorks />
  <TrustSignals />
  <Pricing />
  <FinalCTA />
</BaseLayout>
