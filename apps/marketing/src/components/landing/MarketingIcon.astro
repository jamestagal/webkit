---
// Inline-SVG shim for marketing-landing components. Use instead of <Icon>
// from astro-icon, which silently breaks SSR for pages where it's used in
// the slot of index.astro under @astrojs/cloudflare@13 + output: 'static'.
// Build "completes" but pages render with empty slot content.
//
// Path data: tabler-icons, viewBox 24x24, stroke-width 2 round/round.
// Add new entries here as new components need them.

interface Props {
  name:
    | "world"
    | "sparkles"
    | "arrow-right"
    | "chevron-right"
    | "check"
    | "clipboard-list"
    | "file-text"
    | "receipt"
    | "signature"
    | "send"
    | "layout-grid"
    | "users"
    | "search"
    | "palette"
    | "shield"
    | "bolt"
    | "chart-bar";
  class?: string;
}

const { name, class: className = "h-5 w-5" } = Astro.props;

const paths: Record<Props["name"], string> = {
