---
/**
 * Inline-SVG icon shim for marketing-landing components.
 *
 * Wraps lucide-static (plain JS string imports of SVGs — no virtual
 * modules, no build-time icon resolution). Use this instead of <Icon>
 * from astro-icon: that component triggers a class of silent prerender
 * failure with @astrojs/cloudflare@13 + output: 'static' (build
 * "completes" but emits 0-byte HTML for affected pages). See upstream
 * cluster: withastro/astro #15923 / #15319 / #15650 / #15194.
 *
 * lucide-static dodges that pipeline entirely AND provides the same
 * icon family the SvelteKit landing was using (lucide-svelte) — brand
 * consistency for free.
 */
import {
  ArrowRight,
  BarChart3,
  Check,
  ChevronRight,
  ClipboardList,
  FileSignature,
  FileText,
  Globe,
  LayoutGrid,
  Palette,
  Receipt,
  Search,
  Send,
  Shield,
  Sparkles,
  Users,
  Zap,
} from "lucide-static";

const iconMap = {
  world: Globe,
  sparkles: Sparkles,
  "arrow-right": ArrowRight,
  "chevron-right": ChevronRight,
  check: Check,
  "clipboard-list": ClipboardList,
  "file-text": FileText,
  receipt: Receipt,
  signature: FileSignature,
  send: Send,
  "layout-grid": LayoutGrid,
  users: Users,
  search: Search,
  palette: Palette,
  shield: Shield,
  bolt: Zap,
  "chart-bar": BarChart3,
} as const;

interface Props {
  name: keyof typeof iconMap;
  class?: string;
}

const { name, class: className = "h-5 w-5" } = Astro.props;

// Inject our class onto the svg tag, replacing lucide's default class.
// lucide-static SVGs ship with class="lucide lucide-{name}" + width/height=24;
// we keep the viewBox + path data, override the class, and let Tailwind
// utility classes (h-N, w-N, text-foo) handle sizing/coloring.
const svg = iconMap[name]
  .replace(/\sclass="lucide[^"]*"/, "")
  .replace(/\swidth="24"/, "")
  .replace(/\sheight="24"/, "")
  .replace("<svg", `<svg class="${className}" aria-hidden="true"`);
---

<Fragment set:html={svg} />
