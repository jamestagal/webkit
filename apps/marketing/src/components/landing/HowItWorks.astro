---
const steps = [
  {
    num: "01",
    title: "Create Your Agency",
    description:
      "Set up your agency profile with branding, logo, and team members. Free to get started.",
  },
  {
    num: "02",
    title: "Customize Your Workflow",
    description:
      "Configure forms, templates, and branding. Tailor dropdown options, colors, and document layouts to match your agency.",
  },
  {
    num: "03",
    title: "Engage Clients",
    description:
      "Send consultations, proposals, quotations, and contracts. Everything flows through branded, professional touchpoints.",
  },
];
---

<section id="how-it-works" class="relative my-20 md:my-32">
  <div class="site-container mx-auto">
    <div class="mx-auto max-w-2xl text-center" data-mos="fade-up" data-mos-anchor="#how-it-works">
      <h2 class="text-base-50 text-3xl font-bold tracking-tight md:text-4xl">
        Up and running in minutes
      </h2>
      <p class="text-base-300 mt-4 text-base md:text-lg">
        Three simple steps to transform how your agency handles client work.
      </p>
    </div>

    <ol class="mt-14 grid gap-8 md:grid-cols-3">
      {
        steps.map((s, i) => (
          <li
            class="relative"
            data-mos="fade-up"
            data-mos-delay={i * 0.15}
            data-mos-anchor="#how-it-works"
          >
            <span
              class="text-primary-500/15 absolute -top-4 left-0 text-7xl font-black leading-none"
              aria-hidden="true"
            >
              {s.num}
            </span>
            <div class="relative pt-8">
              <h3 class="text-base-50 text-xl font-semibold">{s.title}</h3>
              <p class="text-base-300 mt-3 text-sm leading-relaxed md:text-base">
                {s.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
