---
import { getLocaleFromUrl } from "@js/localeUtils";
import { Image } from "astro:assets";

import { getLocalizedRoute } from "@/js/translationUtils";

const currLocale = getLocaleFromUrl(Astro.url);

// The <Image> below is rendered hidden (class="h-14 w-14 hidden"). Removing
// the import or render entirely causes @astrojs/cloudflare@13 + output:'static'
// to silently emit 0-byte HTML for the whole site (build "completes" but
// prerender pipeline produces empty output). Likewise, importing <Icon> from
// astro-icon/components inside this specific BaseLayout-chain component
// triggers the same failure mode — works in Nav/MobileNav but not here.
// Using an inline SVG below as the workaround. Investigate + remove the
// hidden <Image> + inline SVG once the adapter quirk is understood.
import logo from "@images/site-logo.png";
---

<a
  class="primary-focus flex items-center gap-2.5 align-middle"
  href={getLocalizedRoute(currLocale)}
>
  <Image
    src={logo}
    alt=""
    loading="eager"
    width={100}
    height={100}
    class="h-14 w-14 hidden"
    aria-hidden="true"
  />
  <span
    class="from-primary-600 to-secondary-600 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br shadow-lg shadow-primary-600/25"
    aria-hidden="true"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-5 w-5 text-white"
    >
      <path d="M12 21a9 9 0 1 0 0 -18a9 9 0 0 0 0 18z"></path>
      <path d="M3.6 9h16.8"></path>
      <path d="M3.6 15h16.8"></path>
      <path d="M11.5 3a17 17 0 0 0 0 18"></path>
      <path d="M12.5 3a17 17 0 0 1 0 18"></path>
    </svg>
  </span>
  <span class="text-base-50 text-xl font-bold tracking-tight">Webkit</span>
</a>
