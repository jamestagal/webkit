---
import SiteLogo from "@components/SiteLogo/SiteLogo.astro";

// Hardcoded English footer per inventory §10. Galaxy's translationData-backed
// 3-column footer (Cosmic Themes branding, Twitter links, newsletter form)
// replaced with Webkit-minimal: logo + Features/Pricing/Log In links + copyright.

const today = new Date();

const footerLinks = [
  { href: "/#features", text: "Features" },
  { href: "/#pricing", text: "Pricing" },
  // cross-domain: marketing → app
  { href: "https://app.webkit.au/login", text: "Log In" },
];
---

<div class="border-t-base-800/60 mt-20 border-t">
  <footer class="site-container mx-auto w-full py-8">
    <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
      <SiteLogo />

      <nav>
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {
            footerLinks.map((l) => (
              <li>
                <a class="nav__link--base text-sm" href={l.href}>
                  {l.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="text-base-400 text-sm">
        &copy; {today.getFullYear()} Webkit. All rights reserved.
      </p>
    </div>
  </footer>
</div>
